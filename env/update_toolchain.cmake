# Nested BUILDMASTER_CONFIGURED skips env/init_vars. Persist the prefix
# search strings so child runners and create_*_stages still see them.
if(DEFINED CFLAGS)
	_bm_tc_export(CFLAGS "${CFLAGS}")
endif()
if(DEFINED CXXFLAGS)
	_bm_tc_export(CXXFLAGS "${CXXFLAGS}")
endif()
if(DEFINED LDFLAGS)
	_bm_tc_export(LDFLAGS "${LDFLAGS}")
endif()
if(DEFINED INCLUDE)
	_bm_tc_export(INCLUDE "${INCLUDE}")
endif()
if(DEFINED LIB)
	_bm_tc_export(LIB "${LIB}")
endif()
