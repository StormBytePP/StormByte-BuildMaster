_bm_tc_export(BUILDMASTER_ENV_SRCDIR "${BUILDMASTER_ENV_SRCDIR}")
_bm_tc_export(BUILDMASTER_SCRIPTS_ENVDIR "${BUILDMASTER_SCRIPTS_ENVDIR}")
_bm_tc_export_raw("set(ENV_RUNNER ${ENV_RUNNER})")
_bm_tc_export_raw("set(ENV_RUNNER_SILENT ${ENV_RUNNER_SILENT})")
_bm_tc_export_raw("set(ENV_RUNNER_COMPILE ${ENV_RUNNER_COMPILE})")
