# Silent runner (Windows PowerShell 5.1): same env as runner.ps1,
# keep the full log, replay BuildMaster lines live.
# Do not wrap powershell -File runner.ps1 — -File extra args with
# spaces are unsafe (5.1). Payload is --argfile or raw argv; we
# start that executable ourselves.
#
# Invocation: ... -File this.ps1 -- <payload...>
#        or:  ... -File this.ps1 -- --argfile <utf8 lines>

$ErrorActionPreference = 'Continue'

function Set-IfNonEmpty([string]$Name, [string]$Value) {
	if ($null -ne $Value -and $Value -ne '') {
		Set-Item -Path "Env:$Name" -Value $Value
	}
}

function Prepend-IfNonEmpty([string]$Name, [string]$Prefix, [string]$Sep) {
	if ($null -eq $Prefix -or $Prefix -eq '') { return }
	$cur = [Environment]::GetEnvironmentVariable($Name, 'Process')
	if ($null -ne $cur -and $cur -ne '') {
		Set-Item -Path "Env:$Name" -Value ($Prefix + $Sep + $cur)
	} else {
		Set-Item -Path "Env:$Name" -Value $Prefix
	}
}

function Escape-Win32Arg([string]$Arg) {
	if ($null -eq $Arg) { return '""' }
	if ($Arg -notmatch '[ \t"]') { return $Arg }
	$escaped = $Arg -replace '\\','\\' -replace '"','\"'
	return '"' + $escaped + '"'
}

Set-IfNonEmpty 'BUILDMASTER_SILENT_RUNNER' '1'
Set-IfNonEmpty 'PKG_CONFIG' '@PKG_CONFIG@'
Prepend-IfNonEmpty 'PKG_CONFIG_PATH' '@PKG_CONFIG_PATH@' ';'
Prepend-IfNonEmpty 'LIB' '@LIB@' ';'
Prepend-IfNonEmpty 'INCLUDE' '@INCLUDE@' ';'
Prepend-IfNonEmpty 'PATH' '@PATH@' ';'
Set-IfNonEmpty 'CMAKE_BUILD_PARALLEL_LEVEL' '@NPROC@'
Set-IfNonEmpty 'CCACHE_DIR' '@CCACHE_DIR@'
Set-IfNonEmpty 'SCCACHE_DIR' '@SCCACHE_DIR@'
Set-IfNonEmpty 'CC' '@CMAKE_C_COMPILER@'
Set-IfNonEmpty 'CXX' '@CMAKE_CXX_COMPILER@'
Set-IfNonEmpty 'CMAKE_C_COMPILER_LAUNCHER' '@CMAKE_C_COMPILER_LAUNCHER@'
Set-IfNonEmpty 'CMAKE_CXX_COMPILER_LAUNCHER' '@CMAKE_CXX_COMPILER_LAUNCHER@'
Set-IfNonEmpty 'AR' '@AR@'
Set-IfNonEmpty 'RANLIB' '@RANLIB@'
Set-IfNonEmpty 'NM' '@NM@'

$failMarker = '@BUILDMASTER_FAIL_MARKER@'
if ($failMarker -ne '' -and (Test-Path -LiteralPath $failMarker)) {
	[Console]::Error.WriteLine('Skipped due to previous errors')
	exit 1
}

$argv = @($args)
if ($argv.Count -gt 0 -and $argv[0] -eq '--') {
	if ($argv.Count -gt 1) { $argv = $argv[1..($argv.Count - 1)] } else { $argv = @() }
}

$payload = @()
if ($argv.Count -ge 2 -and $argv[0] -eq '--argfile') {
	$path = [string]$argv[1]
	if (-not (Test-Path -LiteralPath $path)) {
		[Console]::Error.WriteLine("BuildMaster silent runner: argfile not found: $path")
		exit 1
	}
	$payload = @(Get-Content -LiteralPath $path -Encoding UTF8)
} else {
	$payload = @($argv)
}

if ($payload.Count -lt 1) {
	[Console]::Error.WriteLine('Usage: runner_silent.ps1 -- <command> [args...]')
	[Console]::Error.WriteLine('   or: runner_silent.ps1 -- --argfile <path>')
	exit 1
}

$cmd = $payload[0]
$cmdArgs = @()
if ($payload.Count -gt 1) {
	$cmdArgs = $payload[1..($payload.Count - 1)]
}

$log = Join-Path $env:TEMP ('buildmaster.' + [guid]::NewGuid().ToString('N') + '.log')
$logLock = New-Object object
$seen = New-Object 'System.Collections.Concurrent.ConcurrentDictionary[string,byte]'

$psi = New-Object System.Diagnostics.ProcessStartInfo
$psi.FileName = $cmd
$psi.Arguments = ($cmdArgs | ForEach-Object { Escape-Win32Arg $_ }) -join ' '
$psi.UseShellExecute = $false
$psi.RedirectStandardOutput = $true
$psi.RedirectStandardError = $true
$psi.CreateNoWindow = $true
$psi.EnvironmentVariables['BUILDMASTER_SILENT_RUNNER'] = '1'

$p = New-Object System.Diagnostics.Process
$p.StartInfo = $psi

$handler = {
	if ($null -eq $EventArgs.Data) { return }
	$line = $EventArgs.Data
	$state = $Event.MessageData
	[System.Threading.Monitor]::Enter($state.Lock)
	try {
		Add-Content -LiteralPath $state.Log -Value $line -Encoding UTF8
	} finally {
		[System.Threading.Monitor]::Exit($state.Lock)
	}
	$s = $line
	if ($s.StartsWith('-- ')) {
		$s = $s.Substring(3)
	}
	$idx = $s.IndexOf('[BuildMaster/')
	if ($idx -lt 0) {
		return
	}
	$out = $s.Substring($idx)
	if ($s.Contains('[WARNING ') -or $s.Contains('[FATAL ')) {
		[Console]::Error.WriteLine($out)
		[Console]::Error.Flush()
		return
	}
	if (-not $state.Seen.TryAdd($out, 0)) {
		return
	}
	[Console]::Out.WriteLine($out)
	[Console]::Out.Flush()
}

$msg = @{ Log = $log; Lock = $logLock; Seen = $seen }
Register-ObjectEvent -InputObject $p -EventName OutputDataReceived -Action $handler -MessageData $msg | Out-Null
Register-ObjectEvent -InputObject $p -EventName ErrorDataReceived -Action $handler -MessageData $msg | Out-Null

[void]$p.Start()
$p.BeginOutputReadLine()
$p.BeginErrorReadLine()
$p.WaitForExit()
$rc = $p.ExitCode
if ($null -eq $rc) { $rc = 0 }

Get-EventSubscriber | Where-Object { $_.SourceObject -eq $p } | Unregister-Event
$p.Dispose()

if ($rc -ne 0) {
	if (Test-Path -LiteralPath $log) {
		Get-Content -LiteralPath $log -ErrorAction SilentlyContinue |
			ForEach-Object { [Console]::Error.WriteLine($_) }
	}
	Remove-Item -LiteralPath $log -Force -ErrorAction SilentlyContinue
	exit $rc
}

Remove-Item -LiteralPath $log -Force -ErrorAction SilentlyContinue
exit 0
