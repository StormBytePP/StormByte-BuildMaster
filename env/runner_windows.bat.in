@echo off
rem Runner for Windows: PKG_CONFIG/LIB/INCLUDE/PATH, cache dirs, compilers.
rem IMPORTANT: CC/CXX are the real compiler only (cl). Never prefix sccache
rem here — CMake gets CMAKE_*_COMPILER_LAUNCHER via configure.cmake.in;
rem Meson gets CC="sccache cl" only at meson setup via cmake -E env.
setlocal

set "update_pkg_config=@PKG_CONFIG@"
set "update_pkgconfig_path=@PKG_CONFIG_PATH@"
set "update_lib=@LIB@"
set "update_include=@INCLUDE@"
set "update_path=@PATH@"
set "update_nproc=@NPROC@"
set "update_c_compiler=@CMAKE_C_COMPILER@"
set "update_cxx_compiler=@CMAKE_CXX_COMPILER@"
set "update_c_launcher=@CMAKE_C_COMPILER_LAUNCHER@"
set "update_cxx_launcher=@CMAKE_CXX_COMPILER_LAUNCHER@"
set "update_ccache_dir=@CCACHE_DIR@"
set "update_sccache_dir=@SCCACHE_DIR@"
set "bm_fail_marker=@BUILDMASTER_FAIL_MARKER@"

if not "%update_pkg_config%"=="" (
	set "PKG_CONFIG=%update_pkg_config%"
)

if not "%update_pkgconfig_path%"=="" (
	if defined PKG_CONFIG_PATH (
		set "PKG_CONFIG_PATH=%update_pkgconfig_path%;%PKG_CONFIG_PATH%"
	) else (
		set "PKG_CONFIG_PATH=%update_pkgconfig_path%"
	)
)

if not "%update_lib%"=="" (
	if defined LIB (
		set "LIB=%update_lib%;%LIB%"
	) else (
		set "LIB=%update_lib%"
	)
)

if not "%update_include%"=="" (
	if defined INCLUDE (
		set "INCLUDE=%update_include%;%INCLUDE%"
	) else (
		set "INCLUDE=%update_include%"
	)
)

if not "%update_path%"=="" (
	if defined PATH (
		set "PATH=%update_path%;%PATH%"
	) else (
		set "PATH=%update_path%"
	)
)

if not "%update_nproc%"=="" (
	set "CMAKE_BUILD_PARALLEL_LEVEL=%update_nproc%"
)

if not "%update_ccache_dir%"=="" (
	set "CCACHE_DIR=%update_ccache_dir%"
)
if not "%update_sccache_dir%"=="" (
	set "SCCACHE_DIR=%update_sccache_dir%"
)

rem Real compilers only (never "sccache cl" — that breaks nested CMake on MSVC)
if not "%update_c_compiler%"=="" (
	set "CC=%update_c_compiler%"
)
if not "%update_cxx_compiler%"=="" (
	set "CXX=%update_cxx_compiler%"
)

rem Export launchers for tools that read them; do not fold into CC/CXX
if not "%update_c_launcher%"=="" (
	set "CMAKE_C_COMPILER_LAUNCHER=%update_c_launcher%"
)
if not "%update_cxx_launcher%"=="" (
	set "CMAKE_CXX_COMPILER_LAUNCHER=%update_cxx_launcher%"
)

rem Fail-fast: stages write this marker; do not run further runner commands
if not "%bm_fail_marker%"=="" if exist "%bm_fail_marker%" (
	echo Skipped due to previous errors
	endlocal
	exit /b 1
)

if "%~1"=="" (
	echo Usage: %~nx0 ^<command^> [args...]
	endlocal
	exit /b 1
)

cmd /c %*
set "rc=%ERRORLEVEL%"
endlocal & exit /b %rc%
