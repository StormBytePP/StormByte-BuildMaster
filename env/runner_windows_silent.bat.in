@echo off
rem Windows silent runner – pass-through.
rem Output capture is intentionally disabled on Windows because
rem ENV_RUNNER_CMD is already wrapped with "cmd /C ..." and any
rem additional redirection breaks INCLUDE/LIB propagation for MSVC
rem (manifested as missing StormByte/platform.h).
rem Full dump-on-failure remains available on the Unix silent runner.

call @ENV_RUNNER_CMD@ %*
exit /b %ERRORLEVEL%
