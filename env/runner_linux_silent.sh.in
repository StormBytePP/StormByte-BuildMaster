#!/usr/bin/env bash
# Silent runner: keep the full log; replay BuildMaster lines live.
# Bash is required (PIPESTATUS). Do not invoke with sh.
#
# IMPORTANT: do not use `if cmd; then; fi` + `$?` after it — a failed
# condition makes the if-compound exit 0, swallowing the real status.
#
# macOS ships Bash 3.2: no `declare -A`, and `${arr[$non_numeric]}`
# is treated as arithmetic. Dedup uses a newline-delimited string.

set +e

export BUILDMASTER_SILENT_RUNNER=1

_log="$(mktemp "${TMPDIR:-/tmp}/buildmaster.XXXXXX")"
trap 'rm -f "$_log"' EXIT HUP INT TERM

_bm_cmd=( )
if command -v stdbuf >/dev/null 2>&1; then
	_bm_cmd=(stdbuf -oL -eL)
fi

"${_bm_cmd[@]}" @ENV_RUNNER_CMD@ "$@" 2>&1 | {
	_bm_seen=$'\n'
	_bm_replay_line() {
		local _raw="$1"
		local _s="$_raw"
		local _out=""
		if [[ $_s == --\ * ]]; then
			_s="${_s:3}"
		fi
		if [[ $_s != *'[BuildMaster/'* ]]; then
			return
		fi
		_out="${_s#*'[BuildMaster/'}"
		_out="[BuildMaster/${_out}"
		if [[ $_s == *'[WARNING '* || $_s == *'[FATAL '* ]]; then
			printf '%s\n' "$_out" >&2
			return
		fi
		case "$_bm_seen" in
			*$'\n'"$_out"$'\n'*)
				return
				;;
		esac
		_bm_seen="${_bm_seen}${_out}"$'\n'
		printf '%s\n' "$_out"
	}
	while IFS= read -r _line || [[ -n $_line ]]; do
		printf '%s\n' "$_line" >>"$_log"
		_bm_replay_line "$_line"
	done
}
_rc=${PIPESTATUS[0]}

if [[ $_rc -ne 0 ]]; then
	cat "$_log" >&2
	exit "$_rc"
fi
exit 0
