# Oficio strip_res.
# Drop `*.res` members from produced `.lib` (MSVC / clang-cl lib / llvm-lib).
# Emitted only for static + STRIPRES. Other suffixes are skipped here.
# Worker: component/archive/strip_msvc_res.cmake (no-op on other archivers).

set(_BM_OUTPUTS "@_BM_OUTPUTS@")
foreach(_bm_out IN LISTS _BM_OUTPUTS)
	if(_bm_out STREQUAL "")
		continue()
	endif()
	get_filename_component(_bm_out_name "${_bm_out}" NAME)
	if(NOT _bm_out_name MATCHES "\\.[Ll][Ii][Bb]$")
		continue()
	endif()
	execute_process(
		COMMAND "${CMAKE_COMMAND}"
			"-DLIB=${_bm_out}"
			"-DBUILDMASTER_SRCDIR=@BUILDMASTER_SRCDIR@"
			"-DCMAKE_AR=@CMAKE_AR@"
			-P "@BUILDMASTER_SRCDIR@/component/archive/strip_msvc_res.cmake"
		RESULT_VARIABLE _BM_STRIP_RC
	)
	if(NOT _BM_STRIP_RC EQUAL 0)
		_bm_log_message(@_BM_LOG_CHANNEL@ FATAL
			"strip .res failed for @_BM_COMPONENT_TITLE@ (${_bm_out}, exit ${_BM_STRIP_RC})")
	endif()
endforeach()
