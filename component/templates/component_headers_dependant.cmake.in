add_custom_target(@_LIBRARY_CONFIGURE_TARGET@
	COMMAND @ENV_CMAKE_SILENT_COMMAND@ -P "@_LIBRARY_CONFIGURE_FILE@"
	COMMENT "[BuildMaster/CMake    ]: Configuring @_LIBRARY_NAME@@_LIBRARY_TOOLCHAIN_SUFFIX@"
	USES_TERMINAL
	VERBATIM
)

if(NOT "@_LIBRARY_DEPENDENCIES@" STREQUAL "")
	add_dependencies(@_LIBRARY_CONFIGURE_TARGET@ @_LIBRARY_DEPENDENCIES@)
endif()
if(TARGET buildmaster_build_init)
	add_dependencies(@_LIBRARY_CONFIGURE_TARGET@ buildmaster_build_init)
endif()

include(@_LIBRARY_BUILD_FILE@)
add_dependencies(@_LIBRARY_BUILD_TARGET@ @_LIBRARY_CONFIGURE_TARGET@)
include(@_LIBRARY_INSTALL_FILE@)

target_include_directories(@_LIBRARY_NAME@ SYSTEM INTERFACE "@BUILDMASTER_INSTALL_INCLUDEDIR@")
add_dependencies(@_LIBRARY_NAME@ @_LIBRARY_STAGE_INSTALL@)

# Headers have no link line. LINK is already cleared at _bm_comp_create.
set(_bm_link "@_BM_LINK_ITEMS@")
if(NOT _bm_link STREQUAL "")
	message(WARNING
		"[BuildMaster/Component] LINK ignored for headers component '@_LIBRARY_NAME@' (headers do not link)")
endif()
