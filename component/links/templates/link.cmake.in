# Auto-generated by BuildMaster — do not edit
# id=@BM_LINKS_ID@
# title=@BM_LINKS_TITLE@

set(_BM_LINKS_ORIGIN_TITLE "@BM_LINKS_TITLE@")
set(_BM_LINKS_ID "@BM_LINKS_ID@")
set(_BM_LINKS_LIBDIR "@BM_LINKS_LIBDIR@")
set(_BM_LINKS_LIBNAMES "@BM_LINKS_LIBNAMES@")

if(NOT TARGET @BM_LINKS_ID@)
	add_library(@BM_LINKS_ID@ INTERFACE IMPORTED)
endif()

set(_bm_links_aliases "@BM_LINKS_ALIASES@")
foreach(_bm_a IN LISTS _bm_links_aliases)
	if(_bm_a STREQUAL "")
		continue()
	endif()
	if(TARGET "${_bm_a}")
		get_property(_bm_aliased TARGET "${_bm_a}" PROPERTY ALIASED_TARGET)
		if(_bm_aliased STREQUAL "@BM_LINKS_ID@")
			continue()
		endif()
		if(NOT "${_bm_aliased}" STREQUAL "")
			message(FATAL_ERROR
				"BuildMaster links: ALIAS '${_bm_a}' already maps to '${_bm_aliased}'")
		endif()
		continue()
	endif()
	add_library("${_bm_a}" ALIAS @BM_LINKS_ID@)
endforeach()

if(NOT _BM_LINKS_LIBDIR STREQUAL "")
	target_link_directories(@BM_LINKS_ID@ INTERFACE "${_BM_LINKS_LIBDIR}")
endif()

# Do not target_link_libraries(<id> INTERFACE <own produced>).
# NAMES already puts the archive/DLL on consumers. A raw -l<stem>
# breaks when the file lives under a prefix subdir (recursive/cmake).
# _BM_LINKS_LIBNAMES stays in the file so attach can hang dest stems
# onto *another* target.

set(_bm_links_dests "@BM_LINKS_DESTS@")
foreach(_bm_d IN LISTS _bm_links_dests)
	if(_bm_d STREQUAL "" OR _bm_d STREQUAL "@BM_LINKS_ID@")
		continue()
	endif()
	if(TARGET "${_bm_d}")
		target_link_libraries(@BM_LINKS_ID@ INTERFACE "${_bm_d}")
	endif()
endforeach()

set(_bm_links_includes "@BM_LINKS_INCLUDES@")
foreach(_bm_inc IN LISTS _bm_links_includes)
	if(_bm_inc STREQUAL "")
		continue()
	endif()
	target_include_directories(@BM_LINKS_ID@ INTERFACE "${_bm_inc}")
endforeach()

unset(_bm_links_aliases)
unset(_bm_links_dests)
unset(_bm_links_includes)
unset(_bm_a)
unset(_bm_d)
unset(_bm_inc)
unset(_bm_aliased)
