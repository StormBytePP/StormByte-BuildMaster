# Generated by _bm_file_download() – always downloads with retries and optional hash check.
# Template variables (substituted by configure_file @ONLY):
#   @_FILE_URL@  @_FILE_OUTPUT@  @_FILE_TITLE@  @_FILE_EXPECTED_HASH@
#   @_FILE_MAX_RETRIES@  @_FILE_CURRENT_TRY@  @_FILE_INDENT@
#
# EXPECTED_HASH is intentionally NOT passed to file(DOWNLOAD).
# On a failed transfer CMake would otherwise emit:
#   "file DOWNLOAD cannot compute hash on failed download"
# Hash is verified only after STATUS reports success.
# Runs under `cmake -P`: parent functions are not visible unless loaded here.

include("@BUILDMASTER_SRCDIR@/log.cmake")
if(COMMAND _bm_log_level_init)
	_bm_log_level_init()
endif()
include("@BUILDMASTER_SRCDIR@/tools/file/checksum.cmake")

_bm_log_message(FILE LOWLEVEL "Entering buildmaster_download script")

set(_url            "@_FILE_URL@")
set(_output         "@_FILE_OUTPUT@")
set(_title          "@_FILE_TITLE@")
set(_expected_hash  "@_FILE_EXPECTED_HASH@")
set(_max_retries    "@_FILE_MAX_RETRIES@")
set(_current_try    "@_FILE_CURRENT_TRY@")
set(_indent         "@_FILE_INDENT@")

_bm_log_message(FILE DEBUG "Force download for ${_title}")
_bm_log_message(FILE LOWLEVEL "url=${_url}")
_bm_log_message(FILE LOWLEVEL "output=${_output}")
_bm_log_message(FILE LOWLEVEL "expected_hash=${_expected_hash}")
_bm_log_message(FILE LOWLEVEL "max_retries=${_max_retries} current_try=${_current_try}")

## @brief Compare `_file` against `_hash` after a successful download.
## @param[out] _out_var Parent-scope TRUE if the hash matches or `_hash` is empty.
## @param[in]  _file    Local path written by file(DOWNLOAD).
## @param[in]  _hash    `ALGO=hex` (e.g. SHA256=…) or a bare hex (treated as SHA256).
## @note Missing file or mismatch → FALSE. Does not delete the file.
function(_bm_file_dl_checksum_ok _out_var _file _hash)
	_bm_log_message(FILE LOWLEVEL "Entering _bm_file_dl_checksum_ok")
	if("${_hash}" STREQUAL "")
		set(${_out_var} TRUE PARENT_SCOPE)
		_bm_log_message(FILE LOWLEVEL "Exiting _bm_file_dl_checksum_ok (no hash)")
		return()
	endif()

	_bm_tools_file_checksum(_ok "${_file}" "${_hash}")
	set(${_out_var} "${_ok}" PARENT_SCOPE)
	_bm_log_message(FILE LOWLEVEL "Exiting _bm_file_dl_checksum_ok")
endfunction()

## @brief Whether a file(DOWNLOAD) error should not be retried.
## @param[out] _out_var Parent-scope TRUE for permanent failures.
## @param[in]  _msg     Status text from file(DOWNLOAD) (second STATUS list item).
function(_bm_file_dl_is_permanent_error _out_var _msg)
	_bm_log_message(FILE LOWLEVEL "Entering _bm_file_dl_is_permanent_error")
	if("${_msg}" MATCHES "404" OR "${_msg}" MATCHES "[Nn]ot [Ff]ound")
		set(${_out_var} TRUE PARENT_SCOPE)
	else()
		set(${_out_var} FALSE PARENT_SCOPE)
	endif()
	_bm_log_message(FILE LOWLEVEL "Exiting _bm_file_dl_is_permanent_error")
endfunction()

execute_process(COMMAND ${CMAKE_COMMAND} -E echo_append "${_indent}Downloading ${_title}...")

_bm_log_message(FILE LOWLEVEL "file(DOWNLOAD) attempt ${_current_try}/${_max_retries}")
file(DOWNLOAD
	"${_url}"
	"${_output}"
	STATUS _status
	LOG _log
	TIMEOUT 120
	INACTIVITY_TIMEOUT 30
)

list(GET _status 0 _code)
list(GET _status 1 _msg)
_bm_log_message(FILE LOWLEVEL "file(DOWNLOAD) status code=${_code} msg=${_msg}")

while(NOT _code EQUAL 0)
	_bm_file_dl_is_permanent_error(_permanent "${_msg}")
	if(_permanent OR _current_try GREATER_EQUAL _max_retries)
		execute_process(COMMAND ${CMAKE_COMMAND} -E echo " ERROR: ${_msg}")
		set(_fail "Download failed for '${_title}'. URL=${_url} dest=${_output} reason=${_msg}. Network/HTTP error (timeout, 404, TLS, proxy), not a hash check.")
		_bm_log_message(FILE FATAL "${_fail}")
	endif()

	execute_process(COMMAND ${CMAKE_COMMAND} -E echo
		" ERROR: ${_msg}, retrying (${_current_try}/${_max_retries})")
	_bm_log_message(FILE DEBUG "Retrying download for ${_title} (${_current_try}/${_max_retries}): ${_msg}")

	math(EXPR _wait_secs "5 * ${_current_try}")
	execute_process(COMMAND ${CMAKE_COMMAND} -E echo
		"${_indent}Waiting ${_wait_secs} seconds before retry...")
	_bm_log_message(FILE LOWLEVEL "Backoff ${_wait_secs}s")
	execute_process(COMMAND ${CMAKE_COMMAND} -E sleep ${_wait_secs})

	math(EXPR _current_try "${_current_try} + 1")
	execute_process(COMMAND ${CMAKE_COMMAND} -E echo_append "${_indent}Downloading ${_title}...")

	_bm_log_message(FILE LOWLEVEL "file(DOWNLOAD) attempt ${_current_try}/${_max_retries}")
	file(DOWNLOAD
		"${_url}"
		"${_output}"
		STATUS _status
		LOG _log
		TIMEOUT 120
		INACTIVITY_TIMEOUT 30
	)
	list(GET _status 0 _code)
	list(GET _status 1 _msg)
	_bm_log_message(FILE LOWLEVEL "file(DOWNLOAD) status code=${_code} msg=${_msg}")
endwhile()

if(NOT "${_expected_hash}" STREQUAL "")
	_bm_log_message(FILE LOWLEVEL "Verifying downloaded file hash")
	_bm_file_dl_checksum_ok(_hash_ok "${_output}" "${_expected_hash}")
	if(NOT _hash_ok)
		execute_process(COMMAND ${CMAKE_COMMAND} -E echo " ERROR: Hash mismatch")
		file(REMOVE "${_output}")
		set(_fail "Hash mismatch for '${_title}' after a successful download. URL=${_url} file=${_output} algo=${BUILDMASTER_FILE_LAST_HASH_ALGO} expected=${BUILDMASTER_FILE_LAST_HASH_EXPECTED} actual=${BUILDMASTER_FILE_LAST_HASH_ACTUAL}. Transfer worked; this is not retried. Update EXPECTED_HASH from the vendor page, or delete the cached file under BUILDMASTER_DOWNLOADSDIR (stale digest, replaced remote file, corrupt cache, or proxy error page).")
		_bm_log_message(FILE FATAL "${_fail}")
	endif()
	_bm_log_message(FILE DEBUG "Hash OK for ${_title}")
endif()

execute_process(COMMAND ${CMAKE_COMMAND} -E echo " OK")
_bm_log_message(FILE LOWLEVEL "Exiting buildmaster_download script")
