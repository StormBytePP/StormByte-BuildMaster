# Generated by file_download() – always downloads with retries and optional hash check.
# Template variables (substituted by configure_file @ONLY):
#   @_FILE_URL@  @_FILE_OUTPUT@  @_FILE_TITLE@  @_FILE_EXPECTED_HASH@
#   @_FILE_MAX_RETRIES@  @_FILE_CURRENT_TRY@  @_FILE_INDENT@
#
# EXPECTED_HASH is intentionally NOT passed to file(DOWNLOAD).
# On a failed transfer CMake would otherwise emit:
#   "file DOWNLOAD cannot compute hash on failed download"
# Hash is verified only after STATUS reports success.

include("@BUILDMASTER_SRCDIR@/log.cmake")
if(COMMAND buildmaster_loglevel_init)
	buildmaster_loglevel_init()
endif()

set(_url            "@_FILE_URL@")
set(_output         "@_FILE_OUTPUT@")
set(_title          "@_FILE_TITLE@")
set(_expected_hash  "@_FILE_EXPECTED_HASH@")
set(_max_retries    "@_FILE_MAX_RETRIES@")
set(_current_try    "@_FILE_CURRENT_TRY@")
set(_indent         "@_FILE_INDENT@")

# ---------------------------------------------------------------------------
# Local helpers
# ---------------------------------------------------------------------------
function(_file_dl_checksum_ok _out_var _file _hash)
	if("${_hash}" STREQUAL "")
		set(${_out_var} TRUE PARENT_SCOPE)
		return()
	endif()

	if(NOT EXISTS "${_file}")
		set(${_out_var} FALSE PARENT_SCOPE)
		return()
	endif()

	set(_algo "")
	set(_expected "")

	# Form "ALGO=value" (underscore allowed)
	if(_hash MATCHES "^([A-Za-z0-9_]+)=(.+)$")
		set(_algo "${CMAKE_MATCH_1}")
		set(_expected "${CMAKE_MATCH_2}")
	else()
		# Bare hex → default SHA256
		set(_algo "SHA256")
		set(_expected "${_hash}")
	endif()

	string(TOUPPER "${_algo}" _algo)

	file(${_algo} "${_file}" _actual)
	if(_actual STREQUAL _expected)
		set(${_out_var} TRUE PARENT_SCOPE)
	else()
		set(${_out_var} FALSE PARENT_SCOPE)
	endif()
endfunction()

function(_file_dl_is_permanent_error _out_var _msg)
	if("${_msg}" MATCHES "404" OR "${_msg}" MATCHES "[Nn]ot [Ff]ound")
		set(${_out_var} TRUE PARENT_SCOPE)
	else()
		set(${_out_var} FALSE PARENT_SCOPE)
	endif()
endfunction()

# ---------------------------------------------------------------------------
# Start line (no newline yet)
# ---------------------------------------------------------------------------
execute_process(COMMAND ${CMAKE_COMMAND} -E echo_append "${_indent}Downloading ${_title}...")

# ---------------------------------------------------------------------------
# Download (silent; no EXPECTED_HASH on file(DOWNLOAD))
# ---------------------------------------------------------------------------
file(DOWNLOAD
	"${_url}"
	"${_output}"
	STATUS _status
	LOG _log
	TIMEOUT 120
	INACTIVITY_TIMEOUT 30
)

list(GET _status 0 _code)
list(GET _status 1 _msg)

# ---------------------------------------------------------------------------
# Network / HTTP failure → retry with progressive backoff
# ---------------------------------------------------------------------------
while(NOT _code EQUAL 0)
	_file_dl_is_permanent_error(_permanent "${_msg}")
	if(_permanent OR _current_try GREATER_EQUAL _max_retries)
		execute_process(COMMAND ${CMAKE_COMMAND} -E echo " ERROR: ${_msg}")
		buildmaster_message(FILE FATAL "Download failed for ${_title}: ${_msg}")
	endif()

	execute_process(COMMAND ${CMAKE_COMMAND} -E echo
		" ERROR: ${_msg}, retrying (${_current_try}/${_max_retries})")

	math(EXPR _wait_secs "5 * ${_current_try}")
	execute_process(COMMAND ${CMAKE_COMMAND} -E echo
		"${_indent}Waiting ${_wait_secs} seconds before retry...")
	execute_process(COMMAND ${CMAKE_COMMAND} -E sleep ${_wait_secs})

	math(EXPR _current_try "${_current_try} + 1")
	execute_process(COMMAND ${CMAKE_COMMAND} -E echo_append "${_indent}Downloading ${_title}...")

	file(DOWNLOAD
		"${_url}"
		"${_output}"
		STATUS _status
		LOG _log
		TIMEOUT 120
		INACTIVITY_TIMEOUT 30
	)
	list(GET _status 0 _code)
	list(GET _status 1 _msg)
endwhile()

# ---------------------------------------------------------------------------
# Hash check (only after a successful download)
# ---------------------------------------------------------------------------
if(NOT "${_expected_hash}" STREQUAL "")
	_file_dl_checksum_ok(_hash_ok "${_output}" "${_expected_hash}")
	while(NOT _hash_ok)
		if(_current_try GREATER_EQUAL _max_retries)
			file(REMOVE "${_output}")
			execute_process(COMMAND ${CMAKE_COMMAND} -E echo " ERROR: Hash mismatch")
			buildmaster_message(FILE FATAL "Hash mismatch for ${_title} after ${_max_retries} attempt(s)")
		endif()

		execute_process(COMMAND ${CMAKE_COMMAND} -E echo
			" ERROR: Hash mismatch, retrying (${_current_try}/${_max_retries})")
		file(REMOVE "${_output}")

		math(EXPR _wait_secs "5 * ${_current_try}")
		execute_process(COMMAND ${CMAKE_COMMAND} -E echo
			"${_indent}Waiting ${_wait_secs} seconds before retry...")
		execute_process(COMMAND ${CMAKE_COMMAND} -E sleep ${_wait_secs})

		math(EXPR _current_try "${_current_try} + 1")
		execute_process(COMMAND ${CMAKE_COMMAND} -E echo_append "${_indent}Downloading ${_title}...")

		file(DOWNLOAD
			"${_url}"
			"${_output}"
			STATUS _status
			LOG _log
			TIMEOUT 120
			INACTIVITY_TIMEOUT 30
		)
		list(GET _status 0 _code)
		list(GET _status 1 _msg)

		if(NOT _code EQUAL 0)
			_file_dl_is_permanent_error(_permanent "${_msg}")
			if(_permanent OR _current_try GREATER_EQUAL _max_retries)
				execute_process(COMMAND ${CMAKE_COMMAND} -E echo " ERROR: ${_msg}")
				buildmaster_message(FILE FATAL "Download failed for ${_title}: ${_msg}")
			endif()
			file(REMOVE "${_output}")
			set(_hash_ok FALSE)
		else()
			_file_dl_checksum_ok(_hash_ok "${_output}" "${_expected_hash}")
		endif()
	endwhile()
endif()

execute_process(COMMAND ${CMAKE_COMMAND} -E echo " OK")
