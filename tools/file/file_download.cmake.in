# Auto-generated by BuildMaster – do not edit
# Force-download script with retries and optional hash verification

set(_url           "@_FILE_URL@")
set(_output        "@_FILE_OUTPUT@")
set(_title         "@_FILE_TITLE@")
set(_expected_hash "@_FILE_EXPECTED_HASH@")
set(_max_retries   @_FILE_MAX_RETRIES@)
set(_current_try   @_FILE_CURRENT_TRY@)
set(_indent        "@_FILE_INDENT@")

# ----- helper: print the common prefix ---------------------------------
macro(_bm_print_prefix)
	execute_process(COMMAND ${CMAKE_COMMAND} -E echo_append "${_indent}Downloading ${_title}...")
endmacro()

# ----- helper: final OK / ERROR message --------------------------------
macro(_bm_print_result _msg)
	execute_process(COMMAND ${CMAKE_COMMAND} -E echo " ${_msg}")
endmacro()

# ----- start ------------------------------------------------------------
_bm_print_prefix()

# Always download (silent)
file(DOWNLOAD
	"${_url}"
	"${_output}"
	STATUS _status
	LOG    _log
	TLS_VERIFY ON
	# no SHOW_PROGRESS on purpose
)

list(GET _status 0 _code)
list(GET _status 1 _err)

if(NOT _code EQUAL 0)
	# Decide whether to retry
	set(_retry TRUE)
	if(_err MATCHES "404" OR _err MATCHES "Not Found" OR _err MATCHES "HTTP response code said error")
		set(_retry FALSE)
	endif()

	if(_retry AND _current_try LESS_EQUAL _max_retries)
		_bm_print_result("ERROR: ${_err}, retrying (${_current_try}/${_max_retries})")
		execute_process(COMMAND ${CMAKE_COMMAND} -E sleep 2)
		# Re-execute ourselves with incremented try
		math(EXPR _next "${_current_try} + 1")
		# We re-include the same script after setting the new try count
		set(_FILE_CURRENT_TRY ${_next})
		include("${CMAKE_CURRENT_LIST_FILE}")
		return()
	else()
		_bm_print_result("ERROR: ${_err}")
		message(FATAL_ERROR "Download of '${_title}' failed after ${_current_try} attempt(s)")
	endif()
endif()

# Hash check (if requested)
if(NOT _expected_hash STREQUAL "")
	file_checksum_correct(_ok "${_output}" "${_expected_hash}")
	if(_ok)
		_bm_print_result("OK")
	else()
		file(REMOVE "${_output}")
		if(_current_try LESS_EQUAL _max_retries)
			_bm_print_result("ERROR: Hash mismatch, retrying (${_current_try}/${_max_retries})")
			execute_process(COMMAND ${CMAKE_COMMAND} -E sleep 1)
			math(EXPR _next "${_current_try} + 1")
			set(_FILE_CURRENT_TRY ${_next})
			include("${CMAKE_CURRENT_LIST_FILE}")
			return()
		else()
			_bm_print_result("ERROR: Hash mismatch")
			message(FATAL_ERROR "Hash verification failed for '${_title}' after ${_max_retries} attempts")
		endif()
	endif()
else()
	_bm_print_result("OK")
endif()