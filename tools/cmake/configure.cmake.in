execute_process(
	COMMAND @ENV_CMAKE_SILENT_COMMAND@ -Wno-dev -S @_CMAKE_SRCDIR@ -B @_CMAKE_BUILD_DIR@ -G Ninja
		"-DCMAKE_TOOLCHAIN_FILE=@BUILDMASTER_TOOLCHAIN_FILE@"
		"-DCMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@"
		"-DBUILD_SHARED_LIBS=@_CMAKE_SHARED_MODE@"
		"-DCMAKE_INSTALL_PREFIX=@BUILDMASTER_INSTALL_DIR@"
		"-DCMAKE_C_FLAGS=@CMAKE_C_FLAGS@"
		"-DCMAKE_CXX_FLAGS=@CMAKE_CXX_FLAGS@"
		"-DCMAKE_EXE_LINKER_FLAGS=@CMAKE_EXE_LINKER_FLAGS@"
		"-DCMAKE_SHARED_LINKER_FLAGS=@CMAKE_SHARED_LINKER_FLAGS@"
		"-DCMAKE_POSITION_INDEPENDENT_CODE=ON"
		"-DCMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE=@CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE@"
		"-DCMAKE_POLICY_DEFAULT_CMP0141=NEW"
		"-DCMAKE_MSVC_DEBUG_INFORMATION_FORMAT=Embedded"
		"-DCMAKE_C_COMPILER_LAUNCHER=@CMAKE_C_COMPILER_LAUNCHER@"
		"-DCMAKE_CXX_COMPILER_LAUNCHER=@CMAKE_CXX_COMPILER_LAUNCHER@"
		@_CMAKE_OPTIONS@
	WORKING_DIRECTORY "@_CMAKE_BUILD_DIR@"
	RESULT_VARIABLE CMAKE_RESULT
	OUTPUT_VARIABLE CMAKE_OUT
	ERROR_VARIABLE CMAKE_ERROR
)

if(NOT CMAKE_RESULT EQUAL 0)
	message(FATAL_ERROR
		"CMake configure failed for @_CMAKE_COMPONENT_TITLE@ (exit ${CMAKE_RESULT})\n"
		"Working directory: @_CMAKE_BUILD_DIR@\n"
		"--- stdout ---\n${CMAKE_OUT}\n"
		"--- stderr ---\n${CMAKE_ERROR}"
	)
endif()

# Expanded at generation time as the string ON or OFF (avoid bare if(ON))
if("@BUILDMASTER_DEBUG@" STREQUAL "ON")
	if(CMAKE_OUT)
		message(STATUS "[BUILDMASTER_DEBUG] @_CMAKE_COMPONENT_TITLE@ configure stdout:\n${CMAKE_OUT}")
	endif()
	if(CMAKE_ERROR)
		message(STATUS "[BUILDMASTER_DEBUG] @_CMAKE_COMPONENT_TITLE@ configure stderr:\n${CMAKE_ERROR}")
	endif()
endif()