# Generated by BuildMaster – component configure stage (CMake)

set(_BM_STAGE_CONFIGURE "@_CMAKE_STAGE_CONFIGURE@")
set(_BM_STAGE_BUILD "@_CMAKE_STAGE_BUILD@")

if(NOT TARGET ${_BM_STAGE_CONFIGURE})
	add_custom_target(${_BM_STAGE_CONFIGURE}
		COMMAND ${CMAKE_COMMAND} -E echo "Configuring @_CMAKE_COMPONENT_TITLE@"
		COMMAND ${CMAKE_COMMAND} -P "@_CMAKE_CONFIGURE_EXEC_SCRIPT@"
		USES_TERMINAL
		VERBATIM
	)
	if(TARGET buildmaster_build_init)
		add_dependencies(${_BM_STAGE_CONFIGURE} buildmaster_build_init)
	endif()
endif()

# build waits for configure (re-runs configure when cache/build.ninja was removed)
if(TARGET ${_BM_STAGE_BUILD})
	add_dependencies(${_BM_STAGE_BUILD} ${_BM_STAGE_CONFIGURE})
endif()
