add_custom_target(
	@_CMAKE_STAGE_BUILD@
	COMMAND ${CMAKE_COMMAND} -E echo "Compiling @_CMAKE_COMPONENT_TITLE@"
	COMMAND ${CMAKE_COMMAND} -P "@_CMAKE_BUILD_EXEC_SCRIPT@"
	USES_TERMINAL
	VERBATIM
)
if(TARGET @_CMAKE_STAGE_CONFIGURE@)
	add_dependencies(@_CMAKE_STAGE_BUILD@ @_CMAKE_STAGE_CONFIGURE@)
endif()
if(TARGET buildmaster_build_init)
	add_dependencies(@_CMAKE_STAGE_BUILD@ buildmaster_build_init)
endif()
