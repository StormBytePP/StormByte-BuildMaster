# Auto-generated by BuildMaster – run one component install with fail-fast support
# BUILDONLY: skip cmake --install; optional RENAME + STRIPRES + OUTPUT contract
# under BUILDDIR only.
# When @_BM_PC_ENABLED@ is 1, write a helper .pc after RENAME + STRIPRES.
# That file is for *internal* BM consumers of this prefix. FATAL if OUT exists
# (upstream already shipped a .pc). BUILDONLY + PC is rejected at create time.

include("@BUILDMASTER_SRCDIR@/log.cmake")
if(COMMAND buildmaster_loglevel_init)
	buildmaster_loglevel_init()
endif()

if(EXISTS "@BUILDMASTER_FAIL_MARKER@")
	buildmaster_message(CMAKE STATUS "Skipped @_CMAKE_COMPONENT_TITLE@")
	buildmaster_message(CMAKE FATAL "Skipped @_CMAKE_COMPONENT_TITLE@")
endif()

if(NOT "@_BM_BUILDONLY@" STREQUAL "1")
	execute_process(
		COMMAND @_CMAKE_SILENT_CMD_PREFIX@ --install "@_CMAKE_BUILD_DIR@"
		WORKING_DIRECTORY "@_CMAKE_BUILD_DIR@"
		RESULT_VARIABLE _BM_STAGE_RC
	)

	if(NOT _BM_STAGE_RC EQUAL 0)
		if("@BUILDMASTER_FAIL_FAST@" STREQUAL "ON")
			file(MAKE_DIRECTORY "@BUILDMASTER_MARKERS_DIR@")
			file(WRITE "@BUILDMASTER_FAIL_MARKER@" "@_CMAKE_COMPONENT_SAFE@\n")
			file(WRITE "@BUILDMASTER_MARKERS_DIR@/@_CMAKE_COMPONENT_SAFE@.failed" "")
		endif()
		buildmaster_message(CMAKE FATAL
			"Installing @_CMAKE_COMPONENT_TITLE@ failed (exit ${_BM_STAGE_RC})")
	endif()
endif()

# Optional normalize: variant archives → canonical produced names
# (install libdir for normal components; BUILDDIR for BUILDONLY)
if("@_BM_RENAME_ENABLED@" STREQUAL "1")
	execute_process(
		COMMAND "${CMAKE_COMMAND}"
			"-DOUTPUTS=@_CMAKE_OUTPUT_LIBRARIES@"
			"-DBINDIR=@BUILDMASTER_INSTALL_BINDIR@"
			"-DBUILDMASTER_SRCDIR=@BUILDMASTER_SRCDIR@"
			-P "@BUILDMASTER_SRCDIR@/tools/rename/normalize_install_outputs.cmake"
		RESULT_VARIABLE _BM_RENAME_RC
	)
	if(NOT _BM_RENAME_RC EQUAL 0)
		buildmaster_message(CMAKE FATAL
			"Install rename/normalize failed for @_CMAKE_COMPONENT_TITLE@ (exit ${_BM_RENAME_RC})")
	endif()
endif()

# OUTPUT contract: archives must exist; headers stamp may be created here.
set(_BM_OUTPUTS "@_CMAKE_OUTPUT_LIBRARIES@")
foreach(_bm_out IN LISTS _BM_OUTPUTS)
	if(_bm_out STREQUAL "")
		continue()
	endif()
	if(EXISTS "${_bm_out}")
		continue()
	endif()
	get_filename_component(_bm_out_name "${_bm_out}" NAME)
	if(_bm_out_name MATCHES "^\\.bm_.*_headers\\.stamp$")
		get_filename_component(_bm_out_dir "${_bm_out}" DIRECTORY)
		file(MAKE_DIRECTORY "${_bm_out_dir}")
		file(WRITE "${_bm_out}" "")
	else()
		if("@_BM_BUILDONLY@" STREQUAL "1")
			buildmaster_message(CMAKE FATAL
				"BUILDONLY @_CMAKE_COMPONENT_TITLE@: expected output missing under build dir: ${_bm_out}")
		else()
			buildmaster_message(CMAKE FATAL
				"Install of @_CMAKE_COMPONENT_TITLE@ succeeded but expected output is missing: ${_bm_out}")
		endif()
	endif()
endforeach()

# After RENAME + contract: strip .res members from static MSVC/clang-cl libs.
if("@_BM_STRIPRES_ENABLED@" STREQUAL "1")
	foreach(_bm_out IN LISTS _BM_OUTPUTS)
		if(_bm_out STREQUAL "")
			continue()
		endif()
		get_filename_component(_bm_out_name "${_bm_out}" NAME)
		if(NOT _bm_out_name MATCHES "\\.[Ll][Ii][Bb]$")
			continue()
		endif()
		execute_process(
			COMMAND "${CMAKE_COMMAND}"
				"-DLIB=${_bm_out}"
				"-DBUILDMASTER_SRCDIR=@BUILDMASTER_SRCDIR@"
				"-DCMAKE_AR=@CMAKE_AR@"
				-P "@BUILDMASTER_SRCDIR@/tools/archive/strip_msvc_res.cmake"
			RESULT_VARIABLE _BM_STRIP_RC
		)
		if(NOT _BM_STRIP_RC EQUAL 0)
			buildmaster_message(CMAKE FATAL
				"strip .res failed for @_CMAKE_COMPONENT_TITLE@ (${_bm_out}, exit ${_BM_STRIP_RC})")
		endif()
	endforeach()
endif()

# Helper .pc for internal BM consumers of this prefix (not a portable package).
if("@_BM_PC_ENABLED@" STREQUAL "1")
	execute_process(
		COMMAND "${CMAKE_COMMAND}"
			"-DPC_NAME=@_BM_PC_NAME@"
			"-DPC_VERSION=@_BM_PC_VERSION@"
			"-DPC_DESCRIPTION=@_BM_PC_DESCRIPTION@"
			"-DPC_LIBS=@_BM_PC_LIBS@"
			"-DPC_REQUIRES=@_BM_PC_REQUIRES@"
			"-DPC_CFLAGS=@_BM_PC_CFLAGS@"
			"-DPREFIX=@BUILDMASTER_INSTALL_DIR@"
			"-DLIBDIR=@CMAKE_INSTALL_LIBDIR@"
			"-DINCLUDEDIR=@CMAKE_INSTALL_INCLUDEDIR@"
			"-DOUT=@_BM_PC_OUT@"
			"-DBUILDMASTER_SRCDIR=@BUILDMASTER_SRCDIR@"
			-P "@BUILDMASTER_SRCDIR@/tools/pkgconfig/write_pc.cmake"
		RESULT_VARIABLE _BM_PC_RC
	)
	if(NOT _BM_PC_RC EQUAL 0)
		buildmaster_message(CMAKE FATAL
			"helper .pc failed for @_CMAKE_COMPONENT_TITLE@ (exit ${_BM_PC_RC})")
	endif()
endif()
