add_custom_command(
	OUTPUT @_CMAKE_OUTPUT_LIBRARIES@
	COMMAND ${CMAKE_COMMAND} -P "@_CMAKE_INSTALL_LIBRARY_SCRIPT@"
	WORKING_DIRECTORY "@_CMAKE_BUILD_DIR@"
	DEPENDS @_CMAKE_STAGE_BUILD@
	COMMENT "[BuildMaster/Ninja    ]: Installing @_CMAKE_COMPONENT_TITLE@"
	USES_TERMINAL
	VERBATIM
)

add_custom_target(
	@_CMAKE_STAGE_INSTALL@
	DEPENDS @_CMAKE_OUTPUT_LIBRARIES@
)
add_dependencies(@_CMAKE_STAGE_INSTALL@ @_CMAKE_STAGE_BUILD@)
if(TARGET buildmaster_build_init)
	add_dependencies(@_CMAKE_STAGE_INSTALL@ buildmaster_build_init)
endif()

# Post-install git reset: only when the component published to the shared prefix
if(NOT "@_BM_BUILDONLY@" STREQUAL "1")
	if(NOT "@_CMAKE_GIT_POST_INSTALL_RESET@" STREQUAL "")
		add_custom_command(TARGET @_CMAKE_STAGE_INSTALL@ POST_BUILD
			COMMAND ${CMAKE_COMMAND} -P "@_CMAKE_GIT_POST_INSTALL_RESET@"
			COMMENT "[BuildMaster/Git      ]: Resetting git source tree after install"
			VERBATIM
		)
	endif()
endif()
