# Auto-generated by BuildMaster – run one component build with fail-fast support
include("@BUILDMASTER_SRCDIR@/log.cmake")
if(COMMAND _bm_log_level_init)
	_bm_log_level_init()
endif()

if(EXISTS "@BUILDMASTER_FAIL_MARKER@")
	_bm_log_message(CMAKE STATUS "Skipped @_CMAKE_COMPONENT_TITLE@")
	_bm_log_message(CMAKE FATAL "Skipped @_CMAKE_COMPONENT_TITLE@")
endif()

# Parent Ninja already printed COMMENT on a TTY. STATUS is only for a
# piped nested graph (silent runner sets BUILDMASTER_SILENT_RUNNER).
if("$ENV{BUILDMASTER_SILENT_RUNNER}" STREQUAL "1")
	_bm_log_message(NINJA STATUS
		"Compiling @_CMAKE_COMPONENT_TITLE@@_CMAKE_TOOLCHAIN_SUFFIX@")
endif()

execute_process(
	COMMAND @_CMAKE_COMPILE_CMD_PREFIX@ --build "@_CMAKE_BUILD_DIR@" --parallel @NPROC@ @_CMAKE_BUILD_VERBOSE_ARGS@
	WORKING_DIRECTORY "@_CMAKE_BUILD_DIR@"
	RESULT_VARIABLE _BM_STAGE_RC
)

if(NOT _BM_STAGE_RC EQUAL 0)
	if("@BUILDMASTER_FAIL_FAST@" STREQUAL "ON")
		file(MAKE_DIRECTORY "@BUILDMASTER_MARKERS_DIR@")
		file(WRITE "@BUILDMASTER_FAIL_MARKER@" "@_CMAKE_COMPONENT_SAFE@\n")
		file(WRITE "@BUILDMASTER_MARKERS_DIR@/@_CMAKE_COMPONENT_SAFE@.failed" "")
	endif()
	_bm_log_message(CMAKE FATAL "Compiling @_CMAKE_COMPONENT_TITLE@ failed (exit ${_BM_STAGE_RC})")
endif()
