# Auto-generated by BuildMaster – one Meson install + oficios.
# NOINSTALL (_BM_BUILDONLY=1): skip meson install; oficios still run
# under BUILDDIR. @_BM_INSTALL_RULES@ has no feature-flag ifs.

include("@BUILDMASTER_SRCDIR@/log.cmake")
if(COMMAND _bm_log_level_init)
	_bm_log_level_init()
endif()

if(EXISTS "@BUILDMASTER_FAIL_MARKER@")
	_bm_log_message(MESON STATUS "Skipped @_MESON_COMPONENT_TITLE@")
	_bm_log_message(MESON FATAL "Skipped @_MESON_COMPONENT_TITLE@")
endif()

if("$ENV{BUILDMASTER_SILENT_RUNNER}" STREQUAL "1")
	_bm_log_message(NINJA STATUS
		"Installing @_MESON_COMPONENT_TITLE@")
endif()

if(NOT "@_BM_BUILDONLY@" STREQUAL "1")
	execute_process(
		COMMAND @_MESON_SILENT_CMD_PREFIX@ install -C "@_MESON_BUILD_DIR@"
		WORKING_DIRECTORY "@_MESON_BUILD_DIR@"
		RESULT_VARIABLE _BM_STAGE_RC
	)

	if(NOT _BM_STAGE_RC EQUAL 0)
		if("@BUILDMASTER_FAIL_FAST@" STREQUAL "ON")
			file(MAKE_DIRECTORY "@BUILDMASTER_MARKERS_DIR@")
			file(WRITE "@BUILDMASTER_FAIL_MARKER@" "@_MESON_COMPONENT_SAFE@\n")
			file(WRITE "@BUILDMASTER_MARKERS_DIR@/@_MESON_COMPONENT_SAFE@.failed" "")
		endif()
		_bm_log_message(MESON FATAL
			"Installing @_MESON_COMPONENT_TITLE@ failed (exit ${_BM_STAGE_RC})")
	endif()
endif()

if("@_BM_INSTALL_RULES@" STREQUAL "")
	_bm_log_message(MESON FATAL
		"Install rules path empty for @_MESON_COMPONENT_TITLE@")
endif()
if(NOT EXISTS "@_BM_INSTALL_RULES@")
	_bm_log_message(MESON FATAL
		"Install rules missing for @_MESON_COMPONENT_TITLE@: @_BM_INSTALL_RULES@")
endif()
include("@_BM_INSTALL_RULES@")
