add_custom_command(
	OUTPUT @_MESON_OUTPUT_LIBRARIES@
	COMMAND ${CMAKE_COMMAND} -E echo "Installing @_MESON_COMPONENT_TITLE@"
	COMMAND ${CMAKE_COMMAND} -P "@_MESON_INSTALL_EXEC_SCRIPT@"
	WORKING_DIRECTORY "@_MESON_BUILD_DIR@"
	DEPENDS @_MESON_STAGE_BUILD@
	USES_TERMINAL
	VERBATIM
)

add_custom_target(
	@_MESON_STAGE_INSTALL@
	DEPENDS @_MESON_OUTPUT_LIBRARIES@
)
add_dependencies(@_MESON_STAGE_INSTALL@ @_MESON_STAGE_BUILD@)
if(TARGET buildmaster_build_init)
	add_dependencies(@_MESON_STAGE_INSTALL@ buildmaster_build_init)
endif()

if(NOT "@_BM_BUILDONLY@" STREQUAL "1")
	if(NOT "@_MESON_GIT_POST_INSTALL_RESET@" STREQUAL "")
		add_custom_command(TARGET @_MESON_STAGE_INSTALL@ POST_BUILD
			COMMAND ${CMAKE_COMMAND} -E echo "BuildMaster: resetting git repo after install (@_MESON_COMPONENT_TITLE@)"
			COMMAND ${CMAKE_COMMAND} -P "@_MESON_GIT_POST_INSTALL_RESET@"
			COMMENT "Resetting git source tree after install"
			VERBATIM
		)
	endif()
endif()
