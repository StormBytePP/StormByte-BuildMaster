# Auto-generated by BuildMaster – run one Meson install with fail-fast support
if(EXISTS "@BUILDMASTER_FAIL_MARKER@")
	message(STATUS "Skipped @_MESON_COMPONENT_TITLE@")
	message(FATAL_ERROR "Skipped @_MESON_COMPONENT_TITLE@")
endif()

execute_process(
	COMMAND @_MESON_SILENT_CMD_PREFIX@ install -C "@_MESON_BUILD_DIR@"
	WORKING_DIRECTORY "@_MESON_BUILD_DIR@"
	RESULT_VARIABLE _BM_STAGE_RC
)

if(NOT _BM_STAGE_RC EQUAL 0)
	if("@BUILDMASTER_FAIL_FAST@" STREQUAL "ON")
		file(MAKE_DIRECTORY "@BUILDMASTER_MARKERS_DIR@")
		file(WRITE "@BUILDMASTER_FAIL_MARKER@" "@_MESON_COMPONENT_SAFE@\n")
		file(WRITE "@BUILDMASTER_MARKERS_DIR@/@_MESON_COMPONENT_SAFE@.failed" "")
	endif()
	message(FATAL_ERROR "Installing @_MESON_COMPONENT_TITLE@ failed (exit ${_BM_STAGE_RC})")
endif()

set(_BM_OUTPUTS "@_MESON_OUTPUT_LIBRARIES@")
foreach(_bm_out IN LISTS _BM_OUTPUTS)
	if(NOT _bm_out STREQUAL "" AND NOT EXISTS "${_bm_out}")
		get_filename_component(_bm_out_dir "${_bm_out}" DIRECTORY)
		file(MAKE_DIRECTORY "${_bm_out_dir}")
		file(WRITE "${_bm_out}" "")
	endif()
endforeach()
