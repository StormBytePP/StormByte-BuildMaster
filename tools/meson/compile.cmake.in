add_custom_target(
	@_MESON_STAGE_BUILD@
	COMMAND ${CMAKE_COMMAND} -E echo "Compiling @_MESON_COMPONENT_TITLE@@_MESON_TOOLCHAIN_SUFFIX@"
	COMMAND ${CMAKE_COMMAND} -P "@_MESON_COMPILE_EXEC_SCRIPT@"
	USES_TERMINAL
	VERBATIM
)
if(TARGET buildmaster_build_init)
	add_dependencies(@_MESON_STAGE_BUILD@ buildmaster_build_init)
endif()
