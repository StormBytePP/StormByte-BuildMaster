# Auto-generated by BuildMaster – nested Meson setup (no git here)

if(NOT EXISTS "@_MESON_BUILD_DIR@/build.ninja")
	if(NOT "@_BM_CONFIGURE_VIA_TARGET@" STREQUAL "1")
		message(STATUS "@_MESON_INDENT_@Configuring @_MESON_COMPONENT_TITLE@@_MESON_TOOLCHAIN_SUFFIX@")
	endif()

	set(_bm_c_launcher [[@CMAKE_C_COMPILER_LAUNCHER@]])
	set(_bm_cxx_launcher [[@CMAKE_CXX_COMPILER_LAUNCHER@]])
	set(_bm_c_compiler [[@CMAKE_C_COMPILER@]])
	set(_bm_cxx_compiler [[@CMAKE_CXX_COMPILER@]])
	set(_bm_ccache_dir [[@CCACHE_DIR@]])
	set(_bm_sccache_dir [[@SCCACHE_DIR@]])
	set(_bm_ar [[@_MESON_AR@]])
	set(_bm_ranlib [[@_MESON_RANLIB@]])
	set(_bm_native [[@_MESON_NATIVE_FILE@]])

	set(_MESON_SETUP_ENV_ARGS "")

	# Prefer Meson native file for compilers + ccache/sccache (documented
	# [binaries] form). Fall back to CC/CXX env only when no native file exists.
	if(_bm_native STREQUAL "")
		if(NOT _bm_c_launcher STREQUAL "")
			if(NOT _bm_c_compiler STREQUAL "")
				list(APPEND _MESON_SETUP_ENV_ARGS "CC=${_bm_c_launcher} ${_bm_c_compiler}")
			else()
				list(APPEND _MESON_SETUP_ENV_ARGS "CC=${_bm_c_launcher}")
			endif()
		elseif(NOT _bm_c_compiler STREQUAL "")
			list(APPEND _MESON_SETUP_ENV_ARGS "CC=${_bm_c_compiler}")
		endif()
		if(NOT _bm_cxx_launcher STREQUAL "")
			if(NOT _bm_cxx_compiler STREQUAL "")
				list(APPEND _MESON_SETUP_ENV_ARGS "CXX=${_bm_cxx_launcher} ${_bm_cxx_compiler}")
			else()
				list(APPEND _MESON_SETUP_ENV_ARGS "CXX=${_bm_cxx_launcher}")
			endif()
		elseif(NOT _bm_cxx_compiler STREQUAL "")
			list(APPEND _MESON_SETUP_ENV_ARGS "CXX=${_bm_cxx_compiler}")
		endif()
	endif()

	if(NOT _bm_ccache_dir STREQUAL "")
		list(APPEND _MESON_SETUP_ENV_ARGS "CCACHE_DIR=${_bm_ccache_dir}")
	endif()
	if(NOT _bm_sccache_dir STREQUAL "")
		list(APPEND _MESON_SETUP_ENV_ARGS "SCCACHE_DIR=${_bm_sccache_dir}")
	endif()
	if(NOT _bm_ar STREQUAL "")
		list(APPEND _MESON_SETUP_ENV_ARGS "AR=${_bm_ar}")
	endif()
	if(NOT _bm_ranlib STREQUAL "")
		list(APPEND _MESON_SETUP_ENV_ARGS "RANLIB=${_bm_ranlib}")
	endif()

	set(_MESON_NATIVE_ARGS "")
	if(NOT _bm_native STREQUAL "")
		list(APPEND _MESON_NATIVE_ARGS "--native-file=${_bm_native}")
	endif()

	# Prefix is ENV_MESON_COMMAND: runner tokens + meson binary.
	set(_bm_runner @_MESON_CMD_PREFIX@)
	list(LENGTH _bm_runner _bm_n)
	if(_bm_n LESS 1)
		message(FATAL_ERROR "[BuildMaster] ENV_MESON_COMMAND is empty")
	endif()
	math(EXPR _bm_last "${_bm_n} - 1")
	list(GET _bm_runner ${_bm_last} _bm_meson_exe)
	list(REMOVE_AT _bm_runner ${_bm_last})

	set(_bm_meson_cmd
		"${_bm_meson_exe}"
		setup
		"@_MESON_BUILD_DIR@"
		"@_MESON_SRCDIR@"
		${_MESON_NATIVE_ARGS}
		"-Dc_args=@_MESON_C_ARGS@"
		"-Dcpp_args=@_MESON_CXX_ARGS@"
		"-Dc_link_args=@_MESON_LINK_ARGS@"
		"-Dcpp_link_args=@_MESON_LINK_ARGS@"
		"-Dbuildtype=@MESON_BUILD_TYPE@"
		"-Ddefault_library=@_MESON_LIBRARY_TYPE@"
		"--prefix=@BUILDMASTER_INSTALL_DIR@"
		"--libdir=@CMAKE_INSTALL_LIBDIR@"
		"-Db_lto=@LTO_ENABLED@"
		@_MESON_OPTIONS@
	)

	if(WIN32)
		file(MAKE_DIRECTORY "@_MESON_BUILD_DIR@")
		set(_bm_argfile "@_MESON_BUILD_DIR@/.bm_meson_setup_argv.txt")
		file(WRITE "${_bm_argfile}" "")
		foreach(_bm_tok IN LISTS _bm_meson_cmd)
			file(APPEND "${_bm_argfile}" "${_bm_tok}\n")
		endforeach()
		set(_bm_meson_invoke ${_bm_runner} --argfile "${_bm_argfile}")
	else()
		set(_bm_meson_invoke ${_bm_runner} ${_bm_meson_cmd})
	endif()

	if(_MESON_SETUP_ENV_ARGS)
		execute_process(
			COMMAND ${CMAKE_COMMAND} -E env ${_MESON_SETUP_ENV_ARGS}
				${_bm_meson_invoke}
			RESULT_VARIABLE MESON_SETUP_RESULT
			OUTPUT_VARIABLE MESON_SETUP_OUT
			ERROR_VARIABLE MESON_SETUP_ERR
		)
	else()
		execute_process(
			COMMAND ${_bm_meson_invoke}
			RESULT_VARIABLE MESON_SETUP_RESULT
			OUTPUT_VARIABLE MESON_SETUP_OUT
			ERROR_VARIABLE MESON_SETUP_ERR
		)
	endif()

	if(NOT MESON_SETUP_RESULT EQUAL 0)
		set(MESON_LOG_FILE "@_MESON_BUILD_DIR@/meson-logs/meson-log.txt")
		set(_meson_log "")
		if(EXISTS "${MESON_LOG_FILE}")
			file(READ "${MESON_LOG_FILE}" _meson_log)
		endif()
		message(FATAL_ERROR
			"Meson setup failed for @_MESON_COMPONENT_TITLE@ (exit ${MESON_SETUP_RESULT})\n"
			"Working directory / build dir: @_MESON_BUILD_DIR@\n"
			"--- stdout ---\n${MESON_SETUP_OUT}\n"
			"--- stderr ---\n${MESON_SETUP_ERR}\n"
			"--- meson-log.txt ---\n${_meson_log}"
		)
	endif()
endif()
