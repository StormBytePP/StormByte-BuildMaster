if(NOT EXISTS "@_MESON_BUILD_DIR@/build.ninja")
	message(STATUS "@_MESON_INDENT_@Configuring @_MESON_COMPONENT_TITLE@")
	execute_process(
		COMMAND @ENV_MESON_COMMAND@ setup "@_MESON_BUILD_DIR@" "@_MESON_SRCDIR@"
			"-Dc_args=@_MESON_C_ARGS@"
			"-Dcpp_args=@_MESON_CXX_ARGS@"
			"-Dc_link_args=@CMAKE_EXE_LINKER_FLAGS@"
			"-Dcpp_link_args=@CMAKE_EXE_LINKER_FLAGS@"
			"-Dbuildtype=@MESON_BUILD_TYPE@"
			"-Ddefault_library=@_MESON_LIBRARY_TYPE@"
			"--prefix=@BUILDMASTER_INSTALL_DIR@"
			"--libdir=@CMAKE_INSTALL_LIBDIR@"
			"-Db_lto=@LTO_ENABLED@"
			@_MESON_OPTIONS@
		RESULT_VARIABLE MESON_SETUP_RESULT
		OUTPUT_VARIABLE MESON_SETUP_OUT
		ERROR_VARIABLE MESON_SETUP_ERR
	)

	if(NOT MESON_SETUP_RESULT EQUAL 0)
		set(MESON_LOG_FILE "@_MESON_BUILD_DIR@/meson-logs/meson-log.txt")
		set(_meson_log "")
		if(EXISTS "${MESON_LOG_FILE}")
			file(READ "${MESON_LOG_FILE}" _meson_log)
		endif()
		message(FATAL_ERROR
			"Meson setup failed for @_MESON_COMPONENT_TITLE@ (exit ${MESON_SETUP_RESULT})\n"
			"Working directory / build dir: @_MESON_BUILD_DIR@\n"
			"--- stdout ---\n${MESON_SETUP_OUT}\n"
			"--- stderr ---\n${MESON_SETUP_ERR}\n"
			"--- meson-log.txt ---\n${_meson_log}"
		)
	endif()

	if(@BUILDMASTER_DEBUG@)
		if(MESON_SETUP_OUT)
			message(STATUS "[BUILDMASTER_DEBUG] @_MESON_COMPONENT_TITLE@ meson setup stdout:\n${MESON_SETUP_OUT}")
		endif()
		if(MESON_SETUP_ERR)
			message(STATUS "[BUILDMASTER_DEBUG] @_MESON_COMPONENT_TITLE@ meson setup stderr:\n${MESON_SETUP_ERR}")
		endif()
	endif()
endif()