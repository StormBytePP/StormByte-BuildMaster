execute_process(
	COMMAND @ENV_GIT_SILENT_COMMAND@ reset --hard
	WORKING_DIRECTORY @GIT_REPO@
	RESULT_VARIABLE GIT_RESULT
	OUTPUT_VARIABLE GIT_OUT
	ERROR_VARIABLE GIT_ERROR
)

if(NOT GIT_RESULT EQUAL 0)
	message(FATAL_ERROR
		"Git reset --hard failed (exit ${GIT_RESULT}) in @GIT_REPO@\n"
		"--- stdout ---\n${GIT_OUT}\n"
		"--- stderr ---\n${GIT_ERROR}"
	)
endif()

execute_process(
	COMMAND @ENV_GIT_SILENT_COMMAND@ clean -fd
	WORKING_DIRECTORY @GIT_REPO@
	RESULT_VARIABLE GIT_RESULT
	OUTPUT_VARIABLE GIT_OUT
	ERROR_VARIABLE GIT_ERROR
)

if(NOT GIT_RESULT EQUAL 0)
	message(FATAL_ERROR
		"Git clean -fd failed (exit ${GIT_RESULT}) in @GIT_REPO@\n"
		"--- stdout ---\n${GIT_OUT}\n"
		"--- stderr ---\n${GIT_ERROR}"
	)
endif()

if("@BUILDMASTER_VERBOSE@" STREQUAL "ON")
	message(STATUS "[BUILDMASTER_VERBOSE] git reset/clean completed in @GIT_REPO@")
endif()