execute_process(
	COMMAND @ENV_GIT_SILENT_COMMAND@ fetch origin
	WORKING_DIRECTORY @GIT_REPO@
	RESULT_VARIABLE GIT_RESULT
	OUTPUT_VARIABLE GIT_OUT
	ERROR_VARIABLE GIT_ERROR
)

if(NOT GIT_RESULT EQUAL 0)
	message(FATAL_ERROR
		"Git fetch failed (exit ${GIT_RESULT}) in @GIT_REPO@\n"
		"--- stdout ---\n${GIT_OUT}\n"
		"--- stderr ---\n${GIT_ERROR}"
	)
endif()

if("@BUILDMASTER_DEBUG@" STREQUAL "ON")
	if(GIT_OUT)
		message(STATUS "[BUILDMASTER_DEBUG] git fetch stdout:\n${GIT_OUT}")
	endif()
	if(GIT_ERROR)
		message(STATUS "[BUILDMASTER_DEBUG] git fetch stderr:\n${GIT_ERROR}")
	endif()
endif()