include("@BUILDMASTER_SRCDIR@/log.cmake")
if(COMMAND buildmaster_loglevel_init)
	buildmaster_loglevel_init()
endif()

execute_process(
	COMMAND @ENV_GIT_SILENT_COMMAND@ fetch origin
	WORKING_DIRECTORY @GIT_REPO@
	RESULT_VARIABLE GIT_RESULT
	OUTPUT_VARIABLE GIT_OUT
	ERROR_VARIABLE GIT_ERROR
)

if(NOT GIT_RESULT EQUAL 0)
	buildmaster_message(GIT FATAL
		"Git fetch failed (exit ${GIT_RESULT}) in @GIT_REPO@\n--- stdout ---\n${GIT_OUT}\n--- stderr ---\n${GIT_ERROR}")
endif()

if(GIT_OUT)
	buildmaster_message(GIT DEBUG "git fetch stdout:\n${GIT_OUT}")
endif()
if(GIT_ERROR)
	buildmaster_message(GIT DEBUG "git fetch stderr:\n${GIT_ERROR}")
endif()
