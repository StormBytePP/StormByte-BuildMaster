include("@BUILDMASTER_SRCDIR@/log.cmake")
if(COMMAND buildmaster_loglevel_init)
	buildmaster_loglevel_init()
endif()

execute_process(
	COMMAND @ENV_GIT_SILENT_COMMAND@ -C @GIT_REPO@ switch -C @GIT_BRANCH@ --track origin/@GIT_BRANCH@
	WORKING_DIRECTORY @GIT_REPO@
	RESULT_VARIABLE GIT_RESULT
	OUTPUT_VARIABLE GIT_OUT
	ERROR_VARIABLE GIT_ERROR
	OUTPUT_STRIP_TRAILING_WHITESPACE
	ERROR_STRIP_TRAILING_WHITESPACE
)

if(NOT GIT_RESULT EQUAL 0)
	buildmaster_message(GIT FATAL
		"Git switch failed (exit ${GIT_RESULT}) branch=@GIT_BRANCH@ repo=@GIT_REPO@\n--- stdout ---\n${GIT_OUT}\n--- stderr ---\n${GIT_ERROR}")
endif()

buildmaster_message(GIT STATUS "Switched to @GIT_BRANCH@")
if(GIT_OUT)
	buildmaster_message(GIT DEBUG "git switch stdout:\n${GIT_OUT}")
endif()
if(GIT_ERROR)
	buildmaster_message(GIT DEBUG "git switch stderr:\n${GIT_ERROR}")
endif()
