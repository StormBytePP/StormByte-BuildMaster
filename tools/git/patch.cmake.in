include("@BUILDMASTER_SRCDIR@/log.cmake")
if(COMMAND _bm_log_level_init)
	_bm_log_level_init()
endif()

execute_process(
	COMMAND @ENV_GIT_SILENT_COMMAND@ apply @GIT_PATCHES@
	WORKING_DIRECTORY @GIT_REPO@
	RESULT_VARIABLE GIT_RESULT
	OUTPUT_VARIABLE GIT_OUT
	ERROR_VARIABLE GIT_ERROR
	OUTPUT_STRIP_TRAILING_WHITESPACE
	ERROR_STRIP_TRAILING_WHITESPACE
)

if(NOT GIT_RESULT EQUAL 0)
	_bm_log_message(GIT FATAL
		"Git patch failed (exit ${GIT_RESULT}) in @GIT_REPO@\n--- stdout ---\n${GIT_OUT}\n--- stderr ---\n${GIT_ERROR}")
endif()

_bm_log_message(GIT STATUS "Applied patch @GIT_PATCHES_DISPLAY@")
if(GIT_OUT)
	_bm_log_message(GIT DEBUG "git apply stdout:\n${GIT_OUT}")
endif()
if(GIT_ERROR)
	_bm_log_message(GIT DEBUG "git apply stderr:\n${GIT_ERROR}")
endif()
