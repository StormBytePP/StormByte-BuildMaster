if("${BUILDMASTER_LINKS_DIR}" STREQUAL "")
    message(FATAL_ERROR "exe-meta-whole: BUILDMASTER_LINKS_DIR empty")
endif()
set(_f "${BUILDMASTER_LINKS_DIR}/wh-exe.cmake")
if(NOT EXISTS "${_f}")
    message(FATAL_ERROR "exe-meta-whole: missing ${_f}")
endif()
file(READ "${_f}" _txt)
if("${_txt}" MATCHES "set\\(_BM_LINKS_LIBNAMES \"([^\"]+)\"\\)")
    message(FATAL_ERROR
        "exe-meta-whole: wh-exe LIBNAMES must be empty, got '${CMAKE_MATCH_1}'")
endif()
set(_fm "${BUILDMASTER_LINKS_DIR}/wh-meta.cmake")
if(EXISTS "${_fm}")
    file(READ "${_fm}" _mt)
    if("${_mt}" MATCHES "whexe")
        message(FATAL_ERROR
            "exe-meta-whole: wh-meta links file mentions whexe\n  ${_fm}")
    endif()
endif()
message(STATUS "[BuildMaster/Core     ]: exe-meta-whole: executable stems kept off links/")
